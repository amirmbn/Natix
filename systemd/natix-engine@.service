[Unit]
Description=Natix engine tunnel %i
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/local/lib/natix/natix-kernel up %i
ExecStart=/usr/local/bin/natix-engine -config /etc/natix/tunnels/%i.env
ExecStopPost=/usr/local/lib/natix/natix-kernel down %i
Restart=always
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
LimitNOFILE=1048576
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
